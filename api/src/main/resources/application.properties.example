spring.datasource.url=jdbc:postgresql://localhost:5432/clothing_store
spring.datasource.username=postgres
spring.datasource.password=your_db_password

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration

server.port=8080

app.jwt.secret=replace-with-a-long-random-secret-key
app.jwt.expiration-ms=86400000

app.upload-dir=uploads

stripe.secret-key=sk_test_your_key_here
stripe.webhook-secret=whsec_your_webhook_secret_here